# Amorçage au premier démarrage uniquement : ensuite, tout se règle dans /settings.
# Aucune de ces variables n'est obligatoire.

DATABASE_URL=sqlite://cyclai.db

# Plugins d'activités (relus à chaque démarrage) : id=url séparés par des virgules,
# et un secret partagé par plugin (16 caractères minimum). Voir docs/PLUGINS.md.
# CYCLAI_PLUGINS=garmin=http://garmin:8080
# CYCLAI_PLUGIN_GARMIN_SECRET=

# Optionnelle : sans clé, utiliser les « rapports IA » téléchargeables.
ANTHROPIC_API_KEY=

# FTP manuel (jamais l'auto-FTP d'une source) et fréquences cardiaques.
FTP_WATTS=200
HR_MAX=190
HR_REST=50

# Profil libre (physiologie, objectifs, terrain, équipement, biais connus),
# réinjecté dans chaque prompt LLM.
ATHLETE_PROFILE=

# Adresse d'écoute (défaut : 0.0.0.0:3000 pour `serve`, 0.0.0.0:3001 pour `serve-api`).
# BIND_ADDR=
